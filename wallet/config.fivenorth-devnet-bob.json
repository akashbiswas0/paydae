{
  "kernel": {
    "id": "paydae-wallet-gateway-bob",
    "clientType": "remote"
  },
  "logging": {
    "level": "debug",
    "format": "pretty"
  },
  "server": {
    "port": 3031,
    "dappPath": "/api/v0/dapp",
    "userPath": "/api/v0/user",
    "allowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ],
    "requestSizeLimit": "5mb",
    "requestRateLimit": 10000,
    "trustProxy": false
  },
  "store": {
    "connection": {
      "type": "sqlite",
      "database": "store.devnet.bob.sqlite"
    }
  },
  "signingStore": {
    "connection": {
      "type": "sqlite",
      "database": "signing_store.devnet.bob.sqlite"
    }
  },
  "bootstrap": {
    "idps": [
      {
        "id": "idp-devnet-self-signed",
        "type": "self_signed",
        "issuer": "unsafe-auth"
      }
    ],
    "networks": [
      {
        "id": "canton:da-devnet-onboarding",
        "name": "Wallet Onboarding (5North DevNet)",
        "description": "Log in here to CREATE your wallet (Wallets page). Then connect the dApp via the main network.",
        "synchronizerId": "global-domain::1220be58c29e65de40bf273be1dc2b266d43a9a002ea5b18955aeef7aac881bb471a",
        "identityProviderId": "idp-devnet-self-signed",
        "auth": {
          "method": "self_signed",
          "issuer": "self-signed",
          "audience": "https://canton.network.global",
          "scope": "openid daml_ledger_api offline_access",
          "clientId": "paydae-wallet",
          "clientSecret": "unsafe"
        },
        "adminAuth": {
          "method": "self_signed",
          "issuer": "self-signed",
          "audience": "https://canton.network.global",
          "scope": "daml_ledger_api",
          "clientId": "paydae-wallet",
          "clientSecret": "unsafe"
        },
        "ledgerApi": {
          "baseUrl": "http://127.0.0.1:9000"
        }
      },
      {
        "id": "canton:da-devnet",
        "name": "Canton DevNet (5North sandbox)",
        "description": "5North shared DevNet validator via local auth-injecting proxy on 127.0.0.1:9000",
        "synchronizerId": "global-domain::1220be58c29e65de40bf273be1dc2b266d43a9a002ea5b18955aeef7aac881bb471a",
        "identityProviderId": "idp-devnet-self-signed",
        "auth": {
          "method": "self_signed",
          "issuer": "self-signed",
          "audience": "https://canton.network.global",
          "scope": "openid daml_ledger_api offline_access",
          "clientId": "6",
          "clientSecret": "unsafe"
        },
        "adminAuth": {
          "method": "self_signed",
          "issuer": "self-signed",
          "audience": "https://canton.network.global",
          "scope": "daml_ledger_api",
          "clientId": "6",
          "clientSecret": "unsafe"
        },
        "ledgerApi": {
          "baseUrl": "http://127.0.0.1:9000"
        }
      }
    ]
  }
